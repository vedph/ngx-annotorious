{
  "name": "ngx-annotorious",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test @myrmidon/ngx-annotorious --watch=false && ng test @myrmidon/cadmus-img-gallery --watch=false && ng test @myrmidon/cadmus-img-gallery-iiif --watch=false",
    "build-ann": "ng build @myrmidon/ngx-annotorious",
    "build-osd": "ng build @myrmidon/ngx-annotorious-osd",
    "build-gal": "ng build @myrmidon/cadmus-img-gallery && ng build @myrmidon/cadmus-img-gallery-iiif",
    "build:libs": "pnpm run build-ann && pnpm run build-osd && pnpm run build-gal",
    "test-ann": "ng test @myrmidon/ngx-annotorious",
    "test-gal": "ng test @myrmidon/cadmus-img-gallery",
    "test-iiif": "ng test @myrmidon/cadmus-img-gallery-iiif"
  },
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@annotorious/annotorious": "^3.9.5",
    "@annotorious/openseadragon": "^3.9.5",
    "@myrmidon/ngx-tools": "^3.0.2",
    "openseadragon": "^6.1.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/user-event": "^14.6.12",
    "@types/openseadragon": "^6.0.0",
    "jsdom": "^31.0.1",
    "ng-packagr": "^22.2.6",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
